#!/usr/bin/env bash
# Run a command inside the PSX decomp toolchain container, with the repo mounted at /work.
#   tools/dk make -s
#   tools/dk python3 tools/scripts/decomp.py next
# Works from Linux, macOS, WSL and Git Bash on Windows (Claude Code's shell there).
set -euo pipefail

IMAGE="${PSX_DECOMP_IMAGE:-psx-decomp:3}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: docker not found. Install/start Docker Desktop (WSL 2 backend on Windows)." >&2
  exit 127
fi
if ! docker info >/dev/null 2>&1; then
  echo "ERROR: Docker daemon not reachable. Start Docker Desktop and retry." >&2
  exit 127
fi

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Building toolchain image $IMAGE (one-time, several minutes)..." >&2
  docker build -q -t "$IMAGE" "$ROOT/tools/docker" >&2
fi

USER_ARGS=()
if command -v cygpath >/dev/null 2>&1; then
  # Git Bash / MSYS: give Docker a Windows path and stop MSYS rewriting /work.
  HOSTDIR="$(cygpath -w "$ROOT")"
  export MSYS_NO_PATHCONV=1
else
  HOSTDIR="$ROOT"
  # On Linux keep file ownership sane; Docker Desktop (mac/win) maps ownership itself.
  if [ "$(uname -s)" = "Linux" ]; then USER_ARGS=(--user "$(id -u):$(id -g)"); fi
fi

# Pass the host git identity through so `decomp.py done --commit` can commit from the container.
GIT_ENV=()
GN="$(git -C "$HOSTDIR" config user.name 2>/dev/null || true)"
GE="$(git -C "$HOSTDIR" config user.email 2>/dev/null || true)"
if [ -n "$GN" ]; then GIT_ENV+=(-e "GIT_AUTHOR_NAME=$GN" -e "GIT_COMMITTER_NAME=$GN"); fi
if [ -n "$GE" ]; then GIT_ENV+=(-e "GIT_AUTHOR_EMAIL=$GE" -e "GIT_COMMITTER_EMAIL=$GE"); fi

# Extra `docker run` arguments, split on spaces (tools/swarm labels its containers to stop them).
EXTRA_ARGS=()
if [ -n "${DK_DOCKER_ARGS:-}" ]; then read -r -a EXTRA_ARGS <<< "$DK_DOCKER_ARGS"; fi

# Name the container after what it runs, so `docker ps` reads e.g. swarm-w1-diff-func_8001562C-1234:
# $DK_NAME (default dk; tools/swarm sets swarm-<slot>), the make target or decomp.py subcommand,
# the function if there is one, and a number that keeps concurrent names unique.
TASK="${1:-sh}"; TASK="${TASK##*/}"; FN=""
case "${1:-}" in
  make)
    for a in "${@:2}"; do
      case "$a" in FUNC=*) FN="${a#FUNC=}" ;; -*|*=*) ;; *) [ "$TASK" = make ] && TASK="$a" ;; esac
    done ;;
  python3|python)
    case "${2:--}" in
      -*) ;;   # python3 -c ..., python3 -m ...: just "python3"
      *) TASK="${2##*/}"; TASK="${TASK%.py}"
         if [ $# -ge 3 ] && [ "${3#-}" = "$3" ]; then TASK="$3"; fi
         if [ $# -ge 4 ] && [ "${4#-}" = "$4" ]; then FN="$4"; fi ;;
    esac ;;
esac
NAME="${DK_NAME:-dk}-${TASK:0:24}${FN:+-${FN:0:40}}-$$$RANDOM"
NAME="$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9_.-' '-')"

exec docker run --rm -i --name "$NAME" ${USER_ARGS[@]+"${USER_ARGS[@]}"} ${GIT_ENV[@]+"${GIT_ENV[@]}"} \
  ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
  -e HOME=/tmp -e PYTHONDONTWRITEBYTECODE=1 \
  -v "$HOSTDIR:/work" -w /work \
  "$IMAGE" "$@"
