#!/usr/bin/env bash
# Refuse commits that would add game data: PS-X EXE files, disc images, splat output, big binaries.
set -euo pipefail
fail=0
while IFS= read -r -d '' f; do
  case "$f" in
    disc/*|asm/*|assets/*|build/*|linkers/*|ext/*|*.bin|*.cue|*.iso|*.img|*.chd)
      echo "pre-commit: refusing game data path: $f" >&2; fail=1; continue ;;
  esac
  [ -f "$f" ] || continue
  size=$(wc -c < "$f")
  if [ "$size" -gt 2097152 ]; then
    echo "pre-commit: refusing file over 2 MB: $f" >&2; fail=1; continue
  fi
  if [ "$(head -c 8 "$f" 2>/dev/null)" = "PS-X EXE" ]; then
    echo "pre-commit: refusing PlayStation executable: $f" >&2; fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [ $fail -ne 0 ]; then
  echo "Game data must stay out of the repo (copyright). Unstage those files." >&2
  exit 1
fi

# A match (an INCLUDE_ASM line replaced by C) is committed only through the validation gate,
# `decomp.py done NAME --commit`, which checks scope, lint, the function and the full build.
# Counted, not compared by name: renames and file splits rewrite INCLUDE_ASM lines without
# removing any. A PsyQ gap file deleted whole (decomp.py link-psyq linked Sony's object in its
# place, after a full build check) isn't a match: library code isn't a matching target.
if [ -z "${DECOMP_VALIDATED:-}" ]; then
  gone=$(git diff --cached --name-only --diff-filter=D -- 'src/main/psyq/' | sed 's/^/:(exclude)/')
  diff=$(git diff --cached -U0 -- src $gone)
  removed=$(printf '%s\n' "$diff" | grep -cE '^-[[:space:]]*INCLUDE_ASM\(' || true)
  added=$(printf '%s\n' "$diff" | grep -cE '^\+[[:space:]]*INCLUDE_ASM\(' || true)
  if [ "$removed" -gt "$added" ]; then
    echo "pre-commit: this commit replaces $((removed - added)) INCLUDE_ASM line(s) with C outside the validation gate." >&2
    echo "Commit each match with: tools/dk python3 tools/scripts/decomp.py done NAME --commit" >&2
    exit 1
  fi
fi
