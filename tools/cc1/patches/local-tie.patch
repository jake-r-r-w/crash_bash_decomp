+/* tools/cc1 analysis knob, not in the shipped cc1: with CC1_LOCAL_TIE=reverse,
+   qty_compare_1 and qty_sugg_compare_1 break priority ties by the higher qty
+   number instead of the lower; CC1_LOCAL_LOG=1 prints each block's qtys in
+   allocation order to stderr.  CC1_LOCAL_FUNC=NAME and CC1_LOCAL_BLOCK=N
+   limit both to one function and one basic block.  Unset, nothing changes.
+   Blocks with 3 qtys or fewer sort without these comparators.  */
+
+static void
+local_tie_setup (b)
+     int b;
+{
+  extern char *getenv ();
+  extern int atoi ();
+  char *tie = getenv ("CC1_LOCAL_TIE");
+  char *log = getenv ("CC1_LOCAL_LOG");
+  char *func = getenv ("CC1_LOCAL_FUNC");
+  char *blk = getenv ("CC1_LOCAL_BLOCK");
+  int here = ((! func || (current_function_name
+			   && ! strcmp (func, current_function_name)))
+	      && (! blk || atoi (blk) == b));
+
+  local_tie_reverse = here && tie && ! strcmp (tie, "reverse");
+  local_tie_log_on = here && log && *log && strcmp (log, "0");
+}
+
+static void
+local_tie_log (b, order)
+     int b;
+     int *order;
+{
+  int i, r;
+
+  fprintf (stderr, ";; local-alloc %s block %d: %d qtys in allocation order%s\n",
+	   current_function_name ? current_function_name : "?", b, next_qty,
+	   local_tie_reverse ? " (ties reversed)" : "");
+  for (i = 0; i < next_qty; i++)
+    {
+      int q = order[i];
+
+      fprintf (stderr, ";;   qty %d pri %d refs %d life %d-%d sugg %d/%d -> %s regs",
+	       q, QTY_CMP_PRI (q), qty_n_refs[q], qty_birth[q], qty_death[q],
+	       qty_phys_num_copy_sugg[q], qty_phys_num_sugg[q],
+	       qty_phys_reg[q] >= 0 ? reg_names[qty_phys_reg[q]] : "none");
+      for (r = qty_first_reg[q]; r >= 0; r = reg_next_in_qty[r])
+	fprintf (stderr, " %d", r);
+      if (qty_scratch_rtx[q])
+	fprintf (stderr, " scratch");
+      fprintf (stderr, "\n");
+    }
+}
+
