 }
 
+/* The copies tools/cc1's copy-split knob made in toplev.c (copy_split_insert).  */
+
+extern int copy_split_uid[];
+extern int copy_split_n;
+
+static int
+copy_split_kept (insn)
+     rtx insn;
+{
+  int i;
+
+  for (i = 0; i < copy_split_n; i++)
+    if (INSN_UID (insn) == copy_split_uid[i])
+      return 1;
+  return 0;
+}
