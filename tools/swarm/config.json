{
  "workers": 3,
  "permuters": 2,
  "permuteMinutes": 10,
  "batchMax": 6,
  "maxQueued": 3,
  "seg": "main/main",
  "maxFunctions": 20,
  "maxMinutes": 240,
  "workerMinutes": 45,
  "maxConsecutiveFailures": 3,
  "workerBudgetUsd": 5,
  "maxRunUsd": 50,
  "maxAttempts": 2,
  "remote": "origin",
  "branch": "swarm/integration",
  "base": "main",
  "model": "sonnet",
  "escalateModel": "opus",
  "bigBytes": 600,
  "bigWorkers": 1,
  "bigModel": "opus",
  "bigMinutes": 150,
  "bigBudgetUsd": 20,
  "bigSessions": 6,
  "bigStale": 2,
  "bigPermuteMinutes": 60,
  "escalateBig": true,
  "regions": "all",
  "claudeBin": "claude",
  "prices": {"claude-sonnet-5-5": [2, 10, 0.1, 4], "claude-opus-5-5": [4, 20, 0.2, 8]},
  "claudeArgs": ["-p", "--output-format", "json", "--max-turns", "250",
                 "--permission-mode", "dontAsk", "--strict-mcp-config",
                 "--disable-slash-commands"],
  "workerEnv": {"CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1", "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"},
  "allowedTools": ["Read", "Grep", "Glob",
                   "Edit(src/**)", "Edit(include/**)", "Edit(.swarm-result.json)",
                   "Bash(tools/dk:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)",
                   "Bash(grep:*)", "Bash(wc:*)", "Bash(date:*)"],
  "disallowedTools": ["Bash(git commit:*)", "Bash(git push:*)", "Bash(git reset:*)", "Bash(git clean:*)",
                      "Bash(rm:*)",
                      "Bash(tools/dk make permute:*)", "Bash(tools/dk python3 tools/scripts/decomp.py permute:*)", "WebFetch", "WebSearch", "Agent",
                      "TodoWrite", "NotebookEdit"],
  "trailers": ["Co-Authored-By: Claude <noreply@anthropic.com>"]
}
