{
  "workers": 3,
  "permuters": 2,
  "permuteMinutes": 10,
  "seg": "main/main",
  "maxFunctions": 20,
  "maxMinutes": 240,
  "workerMinutes": 45,
  "maxConsecutiveFailures": 3,
  "workerBudgetUsd": 5,
  "maxRunUsd": 50,
  "maxAttempts": 2,
  "remote": "origin",
  "branch": "swarm/integration",
  "base": "main",
  "model": "sonnet",
  "escalateModel": "opus",
  "claudeBin": "claude",
  "claudeArgs": ["-p", "--output-format", "json", "--max-turns", "250",
                 "--permission-mode", "dontAsk", "--strict-mcp-config"],
  "allowedTools": ["Read", "Edit", "Write", "Grep", "Glob", "TodoWrite",
                   "Bash(tools/dk:*)", "Bash(git diff:*)", "Bash(git status:*)", "Bash(git log:*)",
                   "Bash(git show:*)", "Bash(git grep:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)",
                   "Bash(tail:*)", "Bash(grep:*)", "Bash(wc:*)", "Bash(sort:*)", "Bash(uniq:*)",
                   "Bash(find:*)", "Bash(sed -n:*)"],
  "disallowedTools": ["Bash(git commit:*)", "Bash(git push:*)", "Bash(git reset:*)", "Bash(git clean:*)",
                      "Bash(rm:*)",
                      "Bash(tools/dk make permute:*)", "Bash(tools/dk python3 tools/scripts/decomp.py permute:*)", "WebFetch", "WebSearch", "Agent"],
  "trailers": ["Co-Authored-By: Claude <noreply@anthropic.com>"]
}
